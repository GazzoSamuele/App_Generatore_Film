# Porta su cui ascolta il server Express (opzionale, default 3001)
PORT=3001

# Stringa di connessione MongoDB (obbligatoria)
MONGODB_URI=mongodb://localhost:27017/moviematch

# Chiave API di TMDB, serve solo per "npm run importa"
# Si ottiene da https://www.themoviedb.org/settings/api
TMDB_API_KEY=
